meta {
  name: Create reservation
  type: http
  seq: 4
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/reservations
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "passengerName": "Morty Smith",
    "email": "morty.bruno@example.com",
    "destinationId": 1,
    "travelDate": "2099-12-20",
    "passengers": 2,
    "companionIds": [1, 2],
    "tripType": "exploration",
    "insurance": true,
    "comments": "Bruno contract test"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 201
  res.body.data.status: eq CONFIRMED
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("reservationId", body.data.id);
}
