meta {
  name: List reservations
  type: http
  seq: 9
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/reservations
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.data[0].id: eq {{reservationId}}
}
