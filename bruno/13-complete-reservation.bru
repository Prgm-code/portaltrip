meta {
  name: Complete reservation
  type: http
  seq: 13
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/api/v1/reservations/{{reservationId}}/complete
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.data.status: eq COMPLETED
}
