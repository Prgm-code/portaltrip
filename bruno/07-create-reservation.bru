meta {
  name: Create reservation
  type: http
  seq: 7
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/reservations
  body: json
  auth: bearer
}

headers {
  content-type: application/json
  Idempotency-Key: 58f13289-82e8-4e67-a196-8b8ef445c978
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "passengerName": "Morty Smith",
    "destinationId": 1,
    "travelDate": "2099-12-20",
    "passengers": 2,
    "companionIds": [1, 2],
    "tripType": "exploration",
    "insurance": true,
    "comments": "Bruno contract test"
  }
}

assert {
  res.status: eq 201
  res.body.status: eq 201
  res.body.data.reservation.status: eq CONFIRMED
  res.body.data.remainingBalance: isNumber
}

script:post-response {
  const body = res.getBody();
  bru.setEnvVar("reservationId", body.data.reservation.id);
  bru.setEnvVar("remainingBalance", String(body.data.remainingBalance));
}
