meta {
  name: Get reservation
  type: http
  seq: 8
  tags: [
    smoke
  ]
}

get {
  url: {{baseUrl}}/api/v1/reservations/{{reservationId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.data.id: eq {{reservationId}}
  res.body.data.status: eq CONFIRMED
}
