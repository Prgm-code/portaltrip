meta {
  name: Reject cancellation of completed reservation
  type: http
  seq: 14
  tags: [
    smoke
  ]
}

patch {
  url: {{baseUrl}}/api/v1/reservations/{{reservationId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 409
  res.body.status: eq 409
}
